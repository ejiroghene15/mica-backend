// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum MoodKey {
  calm
  growth
  joy
  tender
  rest
  heavy
}

enum ResourceKind {
  article
  audio
  video
}

enum ChatRole {
  user
  mica
}

// ------------------------------------------------------------------
// Models
// ------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  refreshToken        String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  onboardingComplete  Boolean   @default(false) @map("onboarding_complete")
  streakDays          Int       @default(0)
  joinedAt            DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  checkIns       CheckIn[]
  journalEntries JournalEntry[]
  conversations  Conversation[]

  @@map("users")
}

/// Static reference data describing each mood — label/blurb/color per MoodKey.
/// Not in the original TS types as a table, but CheckIn/MicaLayer/JournalEntry
/// all reference MoodKey, so this gives that enum a home for label/blurb/color
/// instead of duplicating it in app code. Safe to drop if you'd rather seed
/// this purely in the frontend.
model Mood {
  key   MoodKey @id
  label String
  blurb String
  /// Tailwind token name under `mood.*`, or a hex for `heavy`.
  color String

  @@map("moods")
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  mood      MoodKey
  /// 1–5 intensity
  intensity Int
  note      String?
  tags      String[] @default([])
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  layer MicaLayer?

  @@index([userId, createdAt])
  @@map("check_ins")
}

/// A single accreted layer of "Your Mica". One per check-in (1:1).
model MicaLayer {
  id        String   @id @default(cuid())
  checkInId String   @unique
  mood      MoodKey
  /// resolved hex for rendering
  color     String
  note      String?
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@map("mica_layers")
}

model JournalPrompt {
  id   String @id @default(cuid())
  text String

  entries JournalEntry[]

  @@map("journal_prompts")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  body      String
  mood      MoodKey?
  promptId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt JournalPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model Resource {
  slug        String       @id
  title       String
  kind        ResourceKind
  durationMin Int
  category    String
  excerpt     String
  body        String?
  featured    Boolean      @default(false)

  @@index([category])
  @@map("resources")
}

/// A separable conversation thread (like Claude/ChatGPT).
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  preview   String
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  text           String
  /// Optional quick-reply chips MICA offers after a message.
  suggestions    String[] @default([])
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
